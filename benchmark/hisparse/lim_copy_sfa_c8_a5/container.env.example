# Copy outside the checkout, edit, then export C8_CONFIG=/workspace/c8-a5.env.
# Both repositories: feat/hisparse-lim-copysfa-c8-a5.
KERNEL_SOURCE_DIR=/workspace/sgl-kernel-npu
MODEL_PATH=/models/your-a5-compatible-dsa-model
C8_RESULTS_DIR=/workspace/c8-a5-results
CANN_ENV=/usr/local/Ascend/ascend-toolkit/set_env.sh
ATB_ENV=/usr/local/Ascend/nnal/atb/set_env.sh

# Match devices visible INSIDE this container.
TP_SIZE=8
EP_SIZE=8
ATTN_DP_SIZE=1
MAX_RUNNING_REQUESTS=16
GRAPH_BATCH_SIZE=16
CONTEXT_LENGTH=36864
MAX_TOTAL_TOKENS=131072
CHUNKED_PREFILL_SIZE=2048
MAX_PREFILL_TOKENS=32768
MEM_FRACTION_STATIC=0.8
CACHE_TOKENS=2048
ENABLE_PREFILL_DELAYER=1
PREFILL_DELAYER_MAX_DELAY_PASSES=100
SGLANG_ENABLE_OVERLAP_PLAN_STREAM=1

# KV C8 is separate from weight quantization. Empty means checkpoint detection.
WEIGHT_QUANTIZATION=
LIM_EVAL_MODE=${LIM_EVAL_MODE:-lim_copy_sfa}
MOE_A2A_BACKEND=${MOE_A2A_BACKEND:-deepep}
DEEPEP_MODE=auto
DEEPEP_HYBRID_DEPLOYMENT=1
# Candidates from 217, not an A5 sizing guarantee. Cover padded decode tokens
# per rank; increase capacity/buffer together for larger batches.
SGLANG_DEEPEP_NUM_MAX_DISPATCH_TOKENS_PER_RANK=32
HCCL_BUFFSIZE=1000
# Optional dedicated MoE EP window; takes priority over HCCL_BUFFSIZE for DeepEP.
# DEEPEP_HCCL_BUFFSIZE=1000

HOST=127.0.0.1
PORT=8810
SERVED_MODEL_NAME=c8-a5
C8_TEST_TIMEOUT=3600
C8_SMOKE_ROUNDS=10
C8_SMOKE_CONCURRENCY=8
C8_SMOKE_NEW_TOKENS=32
C8_REQUEST_TIMEOUT=180
# GSM8K client: full test split, repository few-shot completion scorer.
# GSM8K_DATA_PATH=/data/wzy/test.jsonl
# Optional separate training demonstrations instead of the test prefix:
# GSM8K_TRAIN_DATA_PATH=/data/wzy/train.jsonl
# GSM8K_NUM_SHOTS=5
# GSM8K_MAX_NEW_TOKENS=512
# GSM8K_PARALLEL=8
# Unset selects max(4096, CACHE_TOKENS + 256).
# C8_SMOKE_LONG_TOKENS=4096

# Optional communication-only test, before starting the model server.
DEEPEP_TEST_RANKS=8
DEEPEP_TEST_HIDDEN=7168
DEEPEP_TEST_EXPERTS=256
DEEPEP_TEST_TOPK=8
DEEPEP_TEST_LOOPS=10
MASTER_ADDR=127.0.0.1
MASTER_PORT=8831
